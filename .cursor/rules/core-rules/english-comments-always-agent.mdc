   * Fetches the current user from the API.
   * @throws {ApiError} When the session is invalid or the request fails.
   */
  async function fetchUser(userId: string): Promise<User> {
    // ...
  }

  // TODO: Add retry with exponential backoff for transient failures
  // FIXME: Discount codes are not applied in this calculation
